# String de conexão do banco Postgres (Vercel Postgres ou Supabase).
# Exemplo Vercel Postgres / Neon:
#   DATABASE_URL="postgres://usuario:senha@host-pooler.regiao.postgres.vercel-storage.com/verceldb?sslmode=require"
# Exemplo Supabase (use a "Connection string" > "Transaction pooler"):
#   DATABASE_URL="postgres://postgres.xxxx:senha@aws-0-regiao.pooler.supabase.com:6543/postgres"
DATABASE_URL=

# Fuso horário usado para agrupar as vendas por dia nos relatórios.
# Padrão: America/Sao_Paulo
EVENT_TZ=America/Sao_Paulo
